# Copy to backend/.env (git-ignored — see .gitignore and CLAUDE.md's "Never
# put API keys ... in git, or in logs. Use a git-ignored .env."). Every value
# here is optional: with nothing set, POST /api/tutor uses only the
# deterministic, no-LLM answer path — see qentor.tutor.config.

# Set to "true" to let /api/tutor try an LLM before falling back to the
# deterministic template. Leaving this unset (or anything else) disables the
# LLM layer entirely, even if an API key below is present.
QENTOR_TUTOR_LLM_ENABLED=false

# Which qentor.tutor.llm adapter to use. Only "anthropic" exists today.
QENTOR_TUTOR_LLM_PROVIDER=anthropic

# Required for the LLM layer to activate. Never commit a real value here.
QENTOR_TUTOR_LLM_API_KEY=

# Optional model override; defaults to qentor.tutor.llm.DEFAULT_MODEL.
QENTOR_TUTOR_LLM_MODEL=claude-opus-5
