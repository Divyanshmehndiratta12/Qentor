# Copy to .env.local for local development. Never commit a real .env file.

# Set to "true" to use the FIXTURE-labelled mock API adapter instead of the
# real FastAPI backend. Leave unset (default) to talk to the real backend at
# http://127.0.0.1:8000 via the dev-server proxy in vite.config.ts.
# NEVER set this in a production build.
VITE_USE_MOCK_API=false
