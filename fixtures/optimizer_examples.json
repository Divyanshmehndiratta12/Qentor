{
  "description": "Educational rewrite examples for the Lab's Optimize panel. The circuits are the only authority here: the verdicts (status, rules, counts) are what the server's optimiser returns for them, pinned by backend/tests/test_optimizer_examples.py; the web copy (web/src/features/build/optimizeExamples.ts) must match this file exactly.",
  "examples": [
    {
      "id": "two-hadamards-cancel",
      "title": "Two Hadamards in a row",
      "summary": "H followed straight away by H on the same qubit. The rule 'a self-inverse gate twice cancels' should match, and the backend then checks the shorter circuit does the same thing.",
      "expected_status": "VERIFIED_SHORTER",
      "expected_rule_contains": "cancelled adjacent h pair",
      "expected_op_counts": [
        3,
        1
      ],
      "circuit": {
        "schema": "qentor.circuit/1",
        "num_qubits": 2,
        "num_clbits": 0,
        "ops": [
          {
            "gate": "h",
            "targets": [
              0
            ],
            "controls": [],
            "params": [],
            "clbits": []
          },
          {
            "gate": "h",
            "targets": [
              0
            ],
            "controls": [],
            "params": [],
            "clbits": []
